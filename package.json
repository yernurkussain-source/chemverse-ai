{
  "name": "chemverse-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-mediapipe.mjs && node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "glb": "node scripts/sdf-to-glb.mjs",

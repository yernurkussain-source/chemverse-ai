    "@google/model-viewer": "^4.4.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "3dmol": "^2.5.5",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "esbuild": "^0.28.2",
    "html5-qrcode": "^2.3.8",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",

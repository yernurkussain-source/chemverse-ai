# CHEMVERSE AI — орта айнымалыларының үлгісі.
# Көшірме жасаңыз:  Copy-Item .env.example .env.local
# Сосын .env.local ішіне мәндерді "=" белгісінен кейін бос орынсыз қойыңыз.
# .env.local GitHub-қа жіберілмейді. Бұл үлгі файлға нағыз кілттерді жазбаңыз.

# --- Supabase: Project Settings → API Keys ---
# Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — браузерге ашық болуы қауіпсіз
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — ТЕК серверде, ешқашан NEXT_PUBLIC_ деп атамаңыз
SUPABASE_SECRET_KEY=

# --- Демо аккаунттардың құпия сөзі (/demo беті) ---
# Кез келген ұзын кездейсоқ мән (кемінде 16 таңба)
DEMO_USER_PASSWORD=

# --- AI провайдері: Google Gemini ---
# aistudio.google.com → Get API key → Create API key. ТЕК серверде қолданылады.
GOOGLE_GENERATIVE_AI_API_KEY=
# Чат моделі (міндетті емес, әдепкі: gemini-flash-latest)
# AI_CHAT_MODEL=
